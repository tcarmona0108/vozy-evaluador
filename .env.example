# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
# Solo GEMINI_API_KEY es obligatoria; el resto tiene valores por defecto (ver app/config.py).
GEMINI_API_KEY=
# Modelo principal y cadena de respaldo (separada por comas).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Opcional: nivel de razonamiento (minimal|low|medium|high, según el modelo) o presupuesto en tokens.
GEMINI_THINKING_LEVEL=
GEMINI_THINKING_BUDGET=
# Concurrencia del lote, intervalo mínimo entre llamadas (s), timeout (s) y reintentos por modelo.
MAX_CONCURRENCY=
LLM_MIN_INTERVAL_S=
LLM_TIMEOUT_S=
LLM_MAX_RETRIES=
LOG_LEVEL=
# 1 para servir solo la API, sin la interfaz Gradio.
DISABLE_UI=
# Solo para desplegar con scripts/deploy_render.py.
RENDER_API_KEY=
